                    <item name="CodeInput" type_name="gh_string" type_code="10">import ghpythonlib.components as ghcomp
import os

tag_string = ""
for t in tags:
    tag_string += "    - {}\n".format(t.strip())

author_string = ""
for a in authors:
    parts = a.split("@")
    name = parts[0]
    author_string += "    - name: {name}\n".format(name=name.strip())
    gh = ""
    if len(parts) &gt; 1:
        gh = parts[1]
        author_string += "      github: {gh}\n".format(gh=gh.strip())


def get_filename():
    # Get the current Grasshopper document
    ghdoc = ghenv.Component.OnPingDocument()

    # Get the file path
    file_path = ghdoc.FilePath

    # Extract the filename from the file path
    file_name = os.path.basename(file_path)

    return file_name


doc = """---
tiny_description: {tiny_description}
repo_url: {repo_url}
tags:
{tag_string}
authors:
{author_string}
headline_image: {headline_image_url} # fully qualified domain name, not relative.

# NOTE: this file is autogenerated from the GH component
---

# {headline} ({filename})

![An image of what this file actually does](headline_image.PNG)
![A screenshot of the grasshopper canvas](canvas_image.png)

## Summary:

_A **very** short explanation of what this does._

{summary}

## Origin story:

_Why did this file come into being?_

{origin_story}

## Detailed description:

_A much longer explanation of what this does._

{detailed_description}

""".format(
    tag_string=tag_string,
    author_string=author_string,
    headline_image_url=headline_image_url,
    tiny_description=tiny_description,
    headline=headline,
    filename=get_filename(),
    summary=summary,
    origin_story=origin_story,
    detailed_description=detailed_description,
    repo_url=repo_url
)

print (doc)

with open("README.md", "w") as f: # no encoding="utf-8" because of dark ages python 
    f.write(doc)</item>
