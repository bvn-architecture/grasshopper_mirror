                    <item name="CodeInput" type_name="gh_string" type_code="10">"""Provides a scripting component.
    Inputs:
        x: The x script variable
        y: The y script variable
    Output:
        a: The a output variable"""

__author__ = "bdoherty"
__version__ = "2024.09.03"

import rhinoscriptsyntax as rs
import Grasshopper as gh
import os
import ghpythonlib.components as ghcomp
import System.Drawing.Color as sys_colour
import System.Drawing.Point as sys_pt

ghdoc = ghenv.Component.OnPingDocument()
canvas = gh.GH_InstanceServer.ActiveCanvas


def zoom_to_extents():
    # Get the current Grasshopper document
    ghdoc = ghenv.Component.OnPingDocument()

    # Get the active Grasshopper canvas
    canvas = gh.GH_InstanceServer.ActiveCanvas

    # Get the bounding box of all objects in the document
    limitToSelection = False
    bbox = ghdoc.BoundingBox(limitToSelection)

    # Get the canvas viewport
    viewport = canvas.Viewport

    # Set the viewport target to the center of the bounding box
    center = get_bbox_centre(bbox)
    viewport.Target = center

    zoom_factor = get_zoom_factor(bbox, viewport)

    # Apply the zoom factor
    viewport.Zoom = zoom_factor

    # Refresh the canvas
    canvas.Refresh()


def get_bbox_centre(bbox):
    center_x = bbox.X + bbox.Width / 2
    # Calculate the center of the bounding box
    center_y = bbox.Y + bbox.Height / 2
    center = sys_pt(center_x, center_y)
    return center


def get_zoom_factor(bbox, viewport):
    """Calculate the zoom factor to fit the bounding box"""
    zoom_factor_x = viewport.Width / bbox.Width
    zoom_factor_y = viewport.Height / bbox.Height
    zoom_factor = min(zoom_factor_x, zoom_factor_y)
    return zoom_factor


def save_canvas_image(ghdoc, zoom_to_extents):
    """Save the canvas image to the same directory as the Grasshopper file
    E.g. from here: https://www.grasshopper3d.com/forum/topics/save-grashopper-canvas-as-picture-with-python?commentId=2985220%3AComment%3A1798948
    """

    # Get the file path
    file_path = ghdoc.FilePath
    directory_path = os.path.dirname(file_path)

    mode = gh.GUI.Canvas.GH_CanvasMode.Export
    # This, below, just makes a tile
    # vp = gh.GUI.Canvas.GH_Viewport()
    # colour = sys_colour.White
    # bmp = gh.Instances.ActiveCanvas.GenerateHiResImageTile(vp, colour)

    # And this, below, captures the part that's currently on the screen
    # I don't think there's a way to capture the whole canvas
    # But maybe there's a way to trigger a zoom to extents first.
    zoom_to_extents()
    bmp = gh.Instances.ActiveCanvas.GetCanvasScreenBuffer(mode)
    path = os.path.join(directory_path, "canvas_image.png")
    print("Saving canvas image to {}".format(path))
    bmp.Save(path)


if not guard:
    save_canvas_image(ghdoc, zoom_to_extents)
